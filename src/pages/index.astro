---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('de-CH', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base>
  <section class="hero">
    <h1>Handwerk trifft Digitalisierung</h1>
    <p>Ideen, Werkzeuge und Erfahrungen für bessere Abläufe in Schweizer Schreinereien.</p>
  </section>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <a class="card" href={`/blog/${post.id}/`}>
          {post.data.image && <img src={post.data.image} alt="" loading="lazy" />}
          <div class="meta">{fmt(post.data.date)}</div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <div style="margin-top:.6rem">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </a>
      </li>
    ))}
  </ul>
</Base>
