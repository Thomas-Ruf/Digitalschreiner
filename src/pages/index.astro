---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('de-CH', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Zurich' });
---
<Base>
  <div class="container">
    <section class="hero">
      <span class="eyebrow">Schreinerhandwerk · Schweiz</span>
      <h1>Wirksamkeit<br />durch <em>Klarheit.</em></h1>
      <p>Klare Prozesse, sinnvolle Digitalisierung und konkrete Verbesserungen für Schweizer Schreinereien.</p>
    </section>
    <h2 class="section-title">Neueste Beiträge</h2>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a class="card" href={`/blog/${post.id}/`}>
            {post.data.image && <img src={post.data.image} alt="" loading="lazy" />}
            <div class="meta">{fmt(post.data.date)} {post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
