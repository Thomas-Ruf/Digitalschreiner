---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { SITE, AUTHOR } from '../site';
interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; schema?: object; }
const { title, description = SITE.description, image = '/og-image.png', type = 'website', schema } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} – ${SITE.claim}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image.endsWith('.svg') ? '/og-image.png' : image, Astro.site);

const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'de-CH',
    publisher: { '@id': `${SITE.url}/#person` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    name: AUTHOR.name,
    jobTitle: AUTHOR.jobTitle,
    description: AUTHOR.bio,
    url: `${SITE.url}/ueber/`,
    email: AUTHOR.email,
    knowsAbout: ['Schreinerhandwerk', 'Digitalisierung', 'Lean Management', 'Prozessoptimierung', 'Arbeitsvorbereitung', 'CAD/CAM'],
    address: { '@type': 'PostalAddress', addressCountry: 'CH' },
  },
];
const allSchema = schema ? [...baseSchema, schema] : baseSchema;
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR.name} />
    <meta name="theme-color" content="#0B1220" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(allSchema)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a href="/" class="logo" aria-label="digitalschreiner – Startseite">
          <img src="/brand/logo.svg" alt="digitalschreiner" class="site-logo" width="170" height="32" loading="eager" decoding="async" />
        </a>
        <nav aria-label="Hauptnavigation">
          <a href="/">Blog</a>
          <a href="/ueber/">Über</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-brand">
          <a href="/" class="footer-logo-link" aria-label="digitalschreiner – Startseite">
            <img src="/brand/logo-white.svg" alt="digitalschreiner" class="footer-logo" width="149" height="28" loading="lazy" decoding="async" />
          </a>
          <p class="footer-claim">{SITE.claim}</p>
        </div>
        <div class="footer-meta">
          <nav class="footer-nav" aria-label="Fussbereich-Navigation">
            <a href="/">Blog</a>
            <a href="/ueber/">Über</a>
            <a href="/impressum/">Impressum</a>
            <a href="/datenschutz/">Datenschutz</a>
            <a href="/rss.xml">RSS</a>
          </nav>
          <p class="footer-copy">© {new Date().getFullYear()} {AUTHOR.name} · digital-schreiner.ch</p>
        </div>
      </div>
    </footer>
  </body>
</html>
